package com.orbit.player

import android.app.Activity
import android.os.Bundle
import android.graphics.Color
import android.view.Gravity
import android.view.View
import android.widget.Button
import android.widget.LinearLayout
import android.widget.TextView
import androidx.media3.common.MediaItem
import androidx.media3.exoplayer.ExoPlayer
import androidx.media3.ui.PlayerView

class MainActivity : Activity() {
    private var player: ExoPlayer? = null
    private lateinit var root: LinearLayout
    private lateinit var playerView: PlayerView

    private val bg = Color.rgb(12, 15, 25)
    private val accent = Color.rgb(95, 130, 255)
    private val testUrl =
        "https://storage.googleapis.com/exoplayer-test-media-0/BigBuckBunny_320x180.mp4"

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        window.statusBarColor = bg
        window.navigationBarColor = bg

        root = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            setPadding(64, 28, 64, 28)
            gravity = Gravity.CENTER_VERTICAL
            setBackgroundColor(bg)
        }

        val header = TextView(this).apply {
            text = "ORBIT"
            textSize = 34f
            letterSpacing = 0.18f
            setTextColor(Color.WHITE)
            setTypeface(null, android.graphics.Typeface.BOLD)
        }
        root.addView(header)

        val tagline = TextView(this).apply {
            text = "YOUR ENTERTAINMENT, YOUR WAY"
            textSize = 12f
            letterSpacing = 0.14f
            setTextColor(Color.LTGRAY)
            setPadding(0, 4, 0, 28)
        }
        root.addView(tagline)

        val featured = TextView(this).apply {
            text = "WELCOME TO ORBIT"
            textSize = 27f
            setTextColor(Color.WHITE)
            setTypeface(null, android.graphics.Typeface.BOLD)
        }
        root.addView(featured)

        val description = TextView(this).apply {
            text = "Your personal entertainment space.\nA universe of films and shows awaits."
            textSize = 17f
            setTextColor(Color.LTGRAY)
            setPadding(0, 12, 0, 28)
        }
        root.addView(description)

        val playButton = Button(this).apply {
            text = "▶   PLAY TEST VIDEO"
            textSize = 16f
            isFocusable = true
            isFocusableInTouchMode = true
            setTextColor(Color.WHITE)
            setBackgroundTintList(
                android.content.res.ColorStateList.valueOf(accent)
            )
            setOnClickListener { playTestVideo() }
        }
        root.addView(
            playButton,
            LinearLayout.LayoutParams(340, 68)
        )

        val footer = TextView(this).apply {
            text = "ORBIT  •  VERSION 1.0"
            textSize = 11f
            setTextColor(Color.GRAY)
            setPadding(0, 32, 0, 0)
        }
        root.addView(footer)

        playerView = PlayerView(this).apply {
            useController = true
            visibility = View.GONE
        }

        setContentView(root)
        playButton.requestFocus()
    }

    private fun playTestVideo() {
        root.removeAllViews()
        playerView.visibility = View.VISIBLE
        root.addView(
            playerView,
            LinearLayout.LayoutParams(-1, -1)
        )

        if (player == null) {
            player = ExoPlayer.Builder(this).build().also {
                playerView.player = it
                it.setMediaItem(MediaItem.fromUri(testUrl))
                it.prepare()
            }
        }

        player?.play()
    }

    override fun onStop() {
        super.onStop()
        player?.release()
        player = null
    }
}
